# ─── WealthSpot Local Development Environment ─────────────────────────────────
# Copy to services/api/.env for local development with Docker Compose.
# These values match the services defined in docker-compose.yml.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (local Postgres via Docker Compose) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://wealthspot:wealthspot_dev@localhost:5433/wealthspot
DATABASE_ECHO=false

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Dev-only secret — NEVER use in production
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_dev_XXXXXX
CLERK_API_KEY=sk_test_XXXXXX

# ─── Redis / Celery (local Redis via Docker Compose) ──────────────────────────
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# ─── Public Media Storage (local MinIO via Docker Compose) ────────────────────
AWS_ACCESS_KEY_ID=minio_dev
AWS_SECRET_ACCESS_KEY=minio_dev_secret
AWS_S3_BUCKET=wealthspot-media
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/wealthspot-media

# ─── KYC Document Storage (dev: same MinIO bucket) ───────────────────────────
# In production, KYC docs route to Azure Blob. Locally, reuse MinIO.
# Leave KYC_* blank to fall back to the media client above automatically.
KYC_AWS_ACCESS_KEY_ID=
KYC_AWS_SECRET_ACCESS_KEY=
KYC_AWS_S3_BUCKET=wealthspot-kyc
KYC_S3_ENDPOINT_URL=http://localhost:9000
KYC_S3_PUBLIC_URL=

# ─── Razorpay (test mode) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXX
RAZORPAY_ALLOW_UNSIGNED_DEV=true

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Leave blank to disable Sentry in local dev
SENTRY_DSN=

# ─── SMTP (dev: use Mailpit or similar local SMTP catcher) ────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@wealthspot.local
SMTP_FROM_NAME=WealthSpot Dev

# ─── Twilio (dev: leave blank to disable SMS) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dev-fernet-key-replace-with-real-one==

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── CAPTCHA ──────────────────────────────────────────────────────────────────
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
