# ─── WealthSpot Production Environment ────────────────────────────────────────
# Reference for ALL environment variables required in production.
# Secrets are stored in Azure Key Vault and injected via Container Apps secret refs.
# Non-secret config (URLs, bucket names, flags) is set directly in Bicep.
#
# Populate Key Vault with: ./deployment/scripts/02-configure-secrets.sh
# NEVER commit real values to this file.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://app.wealthspot.in,https://wealthspot.in

# ─── Database (Supabase Pro — Mumbai region) ──────────────────────────────────
# Connection pooler URL from Supabase → Project Settings → Database → Connection String
# Use the pgbouncer (transaction mode) URL for best performance with async SQLAlchemy.
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_ECHO=false

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<64-char-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Webhook secret: Clerk Dashboard → Webhooks → wealthspot-api endpoint → Signing Secret
# API key: Clerk Dashboard → API Keys → Secret keys
CLERK_WEBHOOK_SECRET=whsec_XXXXXX
CLERK_API_KEY=sk_live_XXXXXX

# ─── Redis (Upstash — Mumbai) ─────────────────────────────────────────────────
# TLS URL from Upstash console → Redis → Details → rediss:// URL
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379/1

# ─── Public Media Storage (Cloudflare R2) ─────────────────────────────────────
# R2 uses S3-compatible API.
# Account ID: Cloudflare Dashboard → Overview → Account ID
# Access key / secret: R2 → Manage API tokens → Create token
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_S3_BUCKET=wealthspot-media
AWS_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://media.wealthspot.in

# ─── KYC Document Storage (Azure Blob — Central India, private) ───────────────
# Never public. Presigned URLs expire in 1 hour.
# account key: Azure Portal → Storage Account → Access keys → key1
# Container name: kyc-documents (created by Bicep)
KYC_AWS_ACCESS_KEY_ID=wealthspotkycprod
KYC_AWS_SECRET_ACCESS_KEY=<azure-storage-account-key-base64>
KYC_AWS_S3_BUCKET=kyc-documents
KYC_S3_ENDPOINT_URL=https://wealthspotkycprod.blob.core.windows.net
KYC_S3_PUBLIC_URL=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Live keys from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXX
RAZORPAY_ALLOW_UNSIGNED_DEV=false

# ─── Sentry ───────────────────────────────────────────────────────────────────
# DSN from Sentry → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://XXXXXX@o123456.ingest.sentry.io/654321

# ─── SMTP / Email (Resend) ────────────────────────────────────────────────────
# Resend uses SMTP relay: smtp.resend.com:587, username=resend
# API key from https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_XXXXXX
SMTP_FROM_EMAIL=no-reply@wealthspot.in
SMTP_FROM_NAME=WealthSpot

# ─── Twilio (SMS / WhatsApp) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXX
TWILIO_AUTH_TOKEN=XXXXXX
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Back this up. Losing it means losing access to all encrypted fields.
ENCRYPTION_KEY=<fernet-base64-key>

# ─── CAPTCHA ──────────────────────────────────────────────────────────────────
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=<cloudflare-turnstile-secret-key>

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXXX

# ─── Azure (for reference — injected by Container Apps environment) ───────────
# These are set directly in Bicep as non-secret env vars, not in Key Vault.
# AZURE_KEY_VAULT_URI=https://wealthspot-kv-prod.vault.azure.net/
