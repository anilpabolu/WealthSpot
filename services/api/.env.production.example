# ─── WealthSpot API – Production Environment ─────────────
# Copy to .env and fill ALL values before deploying to production.
# NEVER commit this file with real credentials.

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wealthspot:STRONG_PASSWORD@db-host:5432/wealthspot
DATABASE_ECHO=false

# ─── Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Clerk ────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_XXXXXX
CLERK_API_KEY=sk_live_XXXXXX

# ─── Redis / Celery ──────────────────────────────────────
REDIS_URL=redis://redis-host:6379/0
CELERY_BROKER_URL=redis://redis-host:6379/1

# ─── Public Media Storage (Cloudflare R2) ────────────
# R2 uses S3-compatible API. Access key / secret from R2 → Manage API Tokens.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_S3_BUCKET=wealthspot-media
AWS_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://media.wealthspot.in

# ─── KYC Document Storage (Azure Blob Storage) ───────
# Private container in India region. Docs never get public URLs — always presigned.
# Access key: storage account name / secret: storage account key (base64).
# Endpoint format: https://<storage-account-name>.blob.core.windows.net
KYC_AWS_ACCESS_KEY_ID=wealthspotkycprod
KYC_AWS_SECRET_ACCESS_KEY=<azure-storage-account-key-base64>
KYC_AWS_S3_BUCKET=kyc-documents
KYC_S3_ENDPOINT_URL=https://wealthspotkycprod.blob.core.windows.net
KYC_S3_PUBLIC_URL=

# ─── Razorpay (Payments) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXX

# ─── Sentry (Error Monitoring) ───────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://XXXXXX@o123456.ingest.sentry.io/654321

# ─── SMTP (Transactional Email via Resend) ───────────
# Resend uses SMTP relay: host=smtp.resend.com, port=587, user=resend
# Get API key from https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_XXXXXX
SMTP_FROM_EMAIL=no-reply@wealthspot.in
SMTP_FROM_NAME=WealthSpot

# ─── Twilio (SMS / WhatsApp) ─────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXX
TWILIO_AUTH_TOKEN=XXXXXX
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── Encryption (Fernet) ─────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=XXXXXX

# ─── App ──────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
# ⚠️ Set to your actual production domains. Comma-separated, no trailing slash.
CORS_ORIGINS=https://app.wealthspot.in,https://wealthspot.in
# ─── Azure ────────────────────────────────────────────
# Key Vault URI — used by Container Apps to reference secrets at runtime
AZURE_KEY_VAULT_URI=https://wealthspot-kv-prod.vault.azure.net/