{
  "expo": {
    "name": "Netegron",
    "slug": "netegron",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/netegron-mark.png",
    "userInterfaceStyle": "automatic",
    "scheme": "netegron",
    "splash": {
      "image": "./assets/netegron-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B4FCF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.netegron.app",
      "associatedDomains": [
        "applinks:netegron.in",
        "applinks:www.netegron.in"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B4FCF"
      },
      "package": "in.netegron.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "netegron.in" },
            { "scheme": "https", "host": "www.netegron.in" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "netegron" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/netegron-mark.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
